{
  "schemaVersion": 1,
  "modules": [
    {
      "id": "ru.ktalk.meetings",
      "name": "Контур.Толк · KTalk",
      "version": "0.1.1",
      "source": {
        "repository": "https://github.com/darxfame/aster-mail-modules",
        "commit": "e3cf8c6a1245c22113ed1b53e4368e8e2fee7c68",
        "directory": "ktalk"
      },
      "sha256": "c9de01d1983bf64a72989dd69160d7420899474fbea0d7cc284351f723aefb20",
      "permissions": [
        "ui",
        "storage",
        "network",
        "meeting.draft",
        "meeting.launch",
        "auth.session"
      ],
      "networkOrigins": [
        "https://app.ktalk.ru",
        "https://yandex.ktalk.ru"
      ],
      "networkHeaders": [
        "x-auth-token"
      ],
      "optionalOrigins": [
        {
          "domain": "ktalk.ru",
          "includeSubdomains": true
        }
      ],
      "meetingLinks": {
        "scheme": "ktalk",
        "origins": [
          "https://app.ktalk.ru",
          "https://yandex.ktalk.ru"
        ]
      },
      "authentication": {
        "type": "browser-token",
        "origins": [
          "https://app.ktalk.ru",
          "https://yandex.ktalk.ru"
        ],
        "identityOrigins": [
          "https://passport.skbkontur.ru",
          "https://identity.kontur.ru"
        ],
        "capture": {
          "storage": "localStorage",
          "key": "session",
          "tokenPath": [
            "data",
            "token"
          ],
          "expiresAtPath": [
            "data",
            "expiresAt"
          ],
          "rejectPath": [
            "data",
            "anonymous"
          ]
        },
        "authorization": {
          "scheme": "Session"
        }
      },
      "host": {
        "apiVersion": 1,
        "features": [
          "meeting.launch",
          "auth.session",
          "rpc.error-details",
          "network.origin-grants"
        ]
      }
    }
  ]
}
