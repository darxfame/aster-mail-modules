{
  "schemaVersion": 1,
  "modules": [
    {
      "id": "ru.ktalk.meetings",
      "name": "Контур.Толк · KTalk",
      "version": "0.1.4",
      "source": {
        "repository": "https://github.com/darxfame/aster-mail-modules",
        "commit": "db8d884343f947af1172ecc6c907bf4fc2a0c8b8",
        "directory": "ktalk"
      },
      "sha256": "99205e546a9aff743bb71aa906f790c898bd5b2bbf233b652f788f11b611c957",
      "permissions": [
        "ui",
        "storage",
        "network",
        "meeting.draft",
        "meeting.launch",
        "auth.session"
      ],
      "networkOrigins": [
        "https://app.ktalk.ru"
      ],
      "networkHeaders": [
        "x-auth-token"
      ],
      "optionalOrigins": [
        {
          "domain": "ktalk.ru",
          "includeSubdomains": true
        }
      ],
      "meetingLinks": {
        "scheme": "ktalk",
        "origins": [
          "https://app.ktalk.ru"
        ]
      },
      "authentication": {
        "type": "browser-token",
        "origins": [
          "https://app.ktalk.ru"
        ],
        "identityOrigins": [
          "https://passport.skbkontur.ru",
          "https://identity.kontur.ru",
          "https://auth.kontur.ru"
        ],
        "capture": {
          "storage": "localStorage",
          "key": "session",
          "tokenPath": [
            "data",
            "token"
          ],
          "expiresAtPath": [
            "data",
            "expiresAt"
          ],
          "rejectPath": [
            "data",
            "anonymous"
          ]
        },
        "authorization": {
          "scheme": "Session"
        }
      },
      "host": {
        "apiVersion": 1,
        "features": [
          "meeting.launch",
          "auth.session",
          "rpc.error-details",
          "network.origin-grants",
          "settings.migrations"
        ]
      }
    }
  ]
}
