{
  "schemaVersion": 1,
  "modules": [
    {
      "id": "ru.ktalk.meetings",
      "name": "Контур.Толк · KTalk",
      "version": "0.1.7",
      "source": {
        "repository": "https://github.com/darxfame/aster-mail-modules",
        "commit": "97fee41412082ef7e2641311c175a4b1abe6bd57",
        "directory": "ktalk"
      },
      "sha256": "808754b26bfc0ea9c7b842cff00497be4356155b5774ba54472f221002b08999",
      "permissions": [
        "ui",
        "storage",
        "network",
        "meeting.draft",
        "meeting.launch",
        "auth.session"
      ],
      "networkOrigins": [
        "https://app.ktalk.ru"
      ],
      "networkHeaders": [
        "x-auth-token"
      ],
      "optionalOrigins": [
        {
          "domain": "ktalk.ru",
          "includeSubdomains": true
        }
      ],
      "meetingLinks": {
        "scheme": "ktalk",
        "origins": [
          "https://app.ktalk.ru"
        ]
      },
      "authentication": {
        "type": "browser-token",
        "origins": [
          "https://app.ktalk.ru"
        ],
        "identityOrigins": [
          "https://passport.skbkontur.ru",
          "https://identity.kontur.ru",
          "https://auth.kontur.ru"
        ],
        "capture": {
          "storage": "localStorage",
          "key": "session",
          "tokenPath": [
            "data",
            "token"
          ],
          "expiresAtPath": [
            "data",
            "expiresAt"
          ],
          "rejectPath": [
            "data",
            "anonymous"
          ]
        },
        "authorization": {
          "scheme": "Session"
        },
        "startOrigin": "https://app.ktalk.ru",
        "identityRedirects": true
      },
      "host": {
        "apiVersion": 1,
        "features": [
          "meeting.launch",
          "auth.session",
          "rpc.error-details",
          "network.origin-grants",
          "settings.migrations",
          "auth.start-origin",
          "auth.identity-redirects"
        ]
      }
    }
  ]
}
