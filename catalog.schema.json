{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aster Mail Module Catalog 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "modules": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "origin": { "type": "string", "format": "uri", "pattern": "^https://[^/?#*]+$" },
    "origins": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/origin" } },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "source", "sha256", "permissions", "networkOrigins", "networkHeaders", "host"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,79}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 40 },
        "source": {
          "type": "object", "additionalProperties": false, "required": ["repository", "commit", "directory"],
          "properties": {
            "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$", "maxLength": 300 },
            "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "directory": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$", "maxLength": 200 }
          }
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "permissions": { "type": "array", "uniqueItems": true, "items": { "enum": ["ui", "storage", "network", "calendar.read", "meeting.draft", "events", "meeting.launch", "auth.session"] } },
        "networkOrigins": { "$ref": "#/$defs/origins" },
        "networkHeaders": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^x-[a-z][a-z0-9-]{0,63}$" } },
        "optionalOrigins": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["domain", "includeSubdomains"], "properties": { "domain": { "type": "string", "maxLength": 253 }, "includeSubdomains": { "type": "boolean" } } } },
        "meetingLinks": {
          "type": "object", "additionalProperties": false, "required": ["scheme", "origins"],
          "properties": { "scheme": { "const": "ktalk" }, "origins": { "$ref": "#/$defs/origins" } }
        },
        "authentication": {
          "type": "object", "additionalProperties": false, "required": ["type", "origins", "identityOrigins", "capture", "authorization"],
          "properties": {
            "type": { "const": "browser-token" }, "origins": { "$ref": "#/$defs/origins" }, "identityOrigins": { "$ref": "#/$defs/origins" },
            "startOrigin": { "type": "string", "format": "uri", "pattern": "^https://" },
            "identityRedirects": { "type": "boolean" },
            "capture": {
              "type": "object", "additionalProperties": false, "required": ["storage", "key", "tokenPath", "expiresAtPath"],
              "properties": {
                "storage": { "enum": ["localStorage", "sessionStorage"] }, "key": { "type": "string", "minLength": 1, "maxLength": 80 },
                "tokenPath": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
                "expiresAtPath": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
                "rejectPath": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } }
              }
            },
            "authorization": { "type": "object", "additionalProperties": false, "required": ["scheme"], "properties": { "scheme": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,31}$" } } }
          }
        },
        "host": {
          "type": "object", "additionalProperties": false, "required": ["apiVersion", "features"],
          "properties": {
            "apiVersion": { "const": 1 },
            "features": { "type": "array", "uniqueItems": true, "maxItems": 8, "items": { "enum": ["meeting.launch", "auth.session", "auth.start-origin", "auth.identity-redirects", "rpc.error-details", "network.origin-grants", "settings.migrations"] } }
          }
        }
      }
    }
  }
}
