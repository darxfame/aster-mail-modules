index 0000000..7f9f6d7
--- /dev/null
+++ b/test/module-auth.test.cjs
@@ -0,0 +1,73 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { EventEmitter } = require('node:events');
+const M = require('../desktop/modules.cjs');
+const A = require('../desktop/module-auth.cjs');
+const { ModuleHost } = require('../desktop/module-host.cjs');
+const example = require('../examples/modules/sandbox-demo/module.json');
+const definition = () => M.manifest({ ...example, permissions: ['network', 'storage', 'meeting.launch', 'auth.session'], networkOrigins: ['https://company.ktalk.ru'], meetingLinks: { scheme: 'ktalk', origins: ['https://company.ktalk.ru'] }, authentication: { type: 'ktalk-session', origins: ['https://company.ktalk.ru'], identityOrigins: ['https://sso.example.test'] } });
+test('native routes and corporate auth require explicit permissions, exact origins and vetted schemes', () => {
+  const value = definition();
+  assert.equal(M.meetingTarget(value, 'https://company.ktalk.ru/test_room?pin=1234'), 'ktalk://company.ktalk.ru/test_room?pin=1234');
+  for (const input of ['http://company.ktalk.ru/test_room', 'https://evil.test/test_room', 'https://company.ktalk.ru.evil.test/test_room', 'https://x@company.ktalk.ru/test_room', 'https://company.ktalk.ru/api', 'https://company.ktalk.ru/%2e%2e/a', 'https://company.ktalk.ru/a/b']) assert.equal(M.meetingTarget(value, input), null);
+  assert.equal(M.meetingTarget(M.manifest(example), 'https://company.ktalk.ru/test_room'), null);
+  for (const patch of [
+    { meetingLinks: { scheme: 'file', origins: ['https://company.ktalk.ru'] } },
+    { meetingLinks: { scheme: 'ktalk', origins: ['https://*.ktalk.ru'] } },
+    { authentication: { ...value.authentication, origins: ['https://evil.test'] } },
+    { permissions: ['network', 'storage'] }
+  ]) assert.throws(() => M.manifest({ ...value, ...patch }));
+});
+function fixture() {
+  const route = definition(), calls = [];
+  const active = { sessionId: 'fictional', signal: new AbortController().signal, records: [{ id: route.id, version: route.version, digest: 'a'.repeat(64), enabled: true, data: {}, auth: { origin: 'https://company.ktalk.ru', token: 'fictional-private-session', expiresAt: '2099-01-01T00:00:00Z' } }] };
+  const electron = { ipcMain: { handle() {}, on() {} }, app: { getApplicationNameForProtocol: () => 'Fictional KTalk' }, shell: { openExternal: async url => { calls.push(url); } } };
+  const host = new ModuleHost({ electron, scope: () => active, save: async records => { active.records = records; } });
+  host.bundle = async () => ({ manifest: route, digest: active.records[0].digest });
+  const entry = { id: route.id, sessionId: active.sessionId, calls: 0, bundle: { manifest: route }, controller: new AbortController(), context: {} };
+  const sender = { mainFrame: {} }; host.senders.set(sender, { entry, role: 'runtime' });
+  return { host, electron, active, entry, calls, event: { sender, senderFrame: sender.mainFrame } };
+}
+test('join launches once, preserves ordinary links, honors disable, retirement and missing applications', async () => {
+  const f = fixture();
+  await f.host.openMeeting('https://company.ktalk.ru/test_room');
+  await f.host.openMeeting('https://meet.google.com/fictional');
+  assert.deepEqual(f.calls, ['ktalk://company.ktalk.ru/test_room', 'https://meet.google.com/fictional']);
+  f.active.records[0].enabled = false;
+  await f.host.openMeeting('https://company.ktalk.ru/test_room'); assert.equal(f.calls.at(-1), 'https://company.ktalk.ru/test_room');
+  f.active.records[0].enabled = true;
+  f.electron.app.getApplicationNameForProtocol = () => ''; await assert.rejects(f.host.openMeeting('https://company.ktalk.ru/test_room')); assert.equal(f.calls.length, 3);
+  f.electron.app.getApplicationNameForProtocol = () => { f.active.sessionId = 'retired'; return 'KTalk'; };
+  await assert.rejects(f.host.openMeeting('https://company.ktalk.ru/test_room')); assert.equal(f.calls.length, 3);
+});
+test('auth session remains out of catalog and storage, is origin bound and can be explicitly deleted', async () => {
+  const f = fixture();
+  const status = await f.host.receive(f.event, 'auth.status', {});
+  assert.equal(status.connected, true); assert.doesNotMatch(JSON.stringify(status), /private-session/);
+  assert.deepEqual(await f.host.receive(f.event, 'storage.get', {}), {});
+  assert.doesNotMatch(JSON.stringify(await f.host.catalog()), /private-session/);
+  await assert.rejects(f.host.receive(f.event, 'network.request', { url: 'https://evil.test/api/Rooms/test', auth: 'session' }));
+  await assert.rejects(f.host.receive(f.event, 'network.request', { url: 'https://company.ktalk.ru/api/Rooms/test', auth: 'session', bearer: 'other' }));
+  f.entry.context = null; await assert.rejects(f.host.receive(f.event, 'auth.signOut', {}));
+  f.entry.context = {}; await f.host.receive(f.event, 'auth.signOut', {});
+  assert.equal(f.active.records[0].auth, undefined);
+});
+test('provider navigation and token parsing reject hostile origins, expired and anonymous sessions', () => {
+  const origins = ['https://company.ktalk.ru', 'https://sso.example.test'];
+  assert.equal(A.allowedNavigation('https://sso.example.test/login?state=fictional', origins), true);
+  for (const url of ['http://sso.example.test', 'https://evil.test', 'file:///tmp/test', 'https://x@sso.example.test', 'https://sso.example.test.evil.test']) assert.equal(A.allowedNavigation(url, origins), false);
+  assert.equal(A.sessionValue({ token: 'bad\r\ntoken', expiresAt: '2099-01-01' }, origins[0]), null);
+  assert.equal(A.sessionValue({ token: 'fictional', expiresAt: '2001-01-01' }, origins[0]), null);
+  const vm = require('node:vm');
+  const read = value => vm.runInNewContext(A.sessionScript, { localStorage: { getItem: () => JSON.stringify(value) } });
+  assert.equal(read({ data: { token: 'fictional', anonymous: true, expiresAt: '2099-01-01' } }), null);
+  assert.equal(read({ data: { token: 'fictional', expiresAt: '2099-01-01' } }).token, 'fictional');
+});
+test('session transport injects only scoped Session authorization and does not use cookies', async () => {
+  let request, options;
+  const net = { request(value) { options = value; request = Object.assign(new EventEmitter(), { headers: {}, setHeader(k, v) { this.headers[k] = v; }, end() {}, abort() {} }); return request; } };
+  const promise = M.requestJSON(net, {}, definition(), { url: 'https://company.ktalk.ru/api/Rooms/test', auth: 'session' }, new AbortController().signal, 'fictional-token');
+  assert.equal(request.headers.Authorization, 'Session fictional-token'); assert.equal(options.useSessionCookies, false); assert.equal(options.credentials, 'omit');
+  const response = Object.assign(new EventEmitter(), { statusCode: 200 }); request.emit('response', response); response.emit('data', Buffer.from('{"roomName":"test"}')); response.emit('end');
+  assert.deepEqual(await promise, { roomName: 'test' });
+});
