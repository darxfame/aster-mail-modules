{
  "apiVersion": 1,
  "id": "ru.ktalk.meetings",
  "version": "0.1.0",
  "type": "integration",
  "name": "Контур.Толк · KTalk",
  "main": "main.js",
  "permissions": ["ui", "storage", "network", "meeting.draft", "meeting.launch", "auth.session"],
  "networkOrigins": ["https://app.ktalk.ru", "https://yandex.ktalk.ru"],
  "networkHeaders": ["x-auth-token"],
  "authentication": {
    "type": "ktalk-session",
    "origins": ["https://app.ktalk.ru", "https://yandex.ktalk.ru"],
    "identityOrigins": ["https://passport.skbkontur.ru", "https://identity.kontur.ru"]
  },
  "meetingLinks": {
    "scheme": "ktalk",
    "origins": ["https://app.ktalk.ru", "https://yandex.ktalk.ru"]
  },
  "commands": [
    { "id": "open", "title": "Контур.Толк · KTalk", "slot": "topbar" },
    { "id": "settings", "title": "Settings", "slot": "internal" },
    { "id": "save", "title": "Save settings", "slot": "internal" },
    { "id": "login", "title": "Corporate sign-in", "slot": "internal" },
    { "id": "logout", "title": "Clear corporate sign-in", "slot": "internal" },
    { "id": "create", "title": "Create room", "slot": "internal" },
    { "id": "check", "title": "Check room", "slot": "internal" },
    { "id": "insert", "title": "Use room", "slot": "internal" },
    { "id": "acknowledge", "title": "Finish room workflow", "slot": "internal" }
  ],
  "views": [
    { "id": "panel", "title": "Контур.Толк · KTalk", "file": "panel.html", "slot": "panel", "height": 500 },
    { "id": "meeting", "title": "Контур.Толк · KTalk", "file": "panel.html", "slot": "meeting.create", "height": 440 }
  ],
  "files": ["main.js", "core.js", "config.js", "i18n.js", "panel.html", "panel.js", "panel.css", "LICENSE"]
}
