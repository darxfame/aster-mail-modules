{
  "apiVersion": 1,
  "id": "ru.ktalk.meetings",
  "version": "0.1.10",
  "type": "integration",
  "name": "Контур.Толк · KTalk",
  "main": "main.js",
  "permissions": [
    "ui",
    "storage",
    "network",
    "meeting.draft",
    "meeting.launch",
    "auth.session"
  ],
  "networkOrigins": [
    "https://app.ktalk.ru"
  ],
  "networkHeaders": [
    "x-auth-token"
  ],
  "authentication": {
    "type": "browser-token",
    "origins": [
      "https://app.ktalk.ru"
    ],
    "identityOrigins": [
      "https://passport.skbkontur.ru",
      "https://identity.kontur.ru",
      "https://auth.kontur.ru"
    ],
    "capture": {
      "storage": "localStorage",
      "key": "session",
      "tokenPath": [
        "data",
        "token"
      ],
      "expiresAtPath": [
        "data",
        "expiresAt"
      ],
      "rejectPath": [
        "data",
        "anonymous"
      ]
    },
    "authorization": {
      "scheme": "Session"
    },
    "startOrigin": "https://app.ktalk.ru",
    "identityRedirects": true
  },
  "meetingLinks": {
    "scheme": "ktalk",
    "origins": [
      "https://app.ktalk.ru"
    ]
  },
  "commands": [
    {
      "id": "save-prefix",
      "title": "Save room prefix",
      "slot": "internal"
    },
    {
      "id": "settings",
      "title": "Settings",
      "slot": "internal"
    },
    {
      "id": "save",
      "title": "Save settings",
      "slot": "internal"
    },
    {
      "id": "login",
      "title": "Corporate sign-in",
      "slot": "internal"
    },
    {
      "id": "logout",
      "title": "Clear corporate sign-in",
      "slot": "internal"
    },
    {
      "id": "reset",
      "title": "Reset settings",
      "slot": "internal"
    },
    {
      "id": "create",
      "title": "Create room",
      "slot": "internal"
    },
    {
      "id": "check",
      "title": "Check room",
      "slot": "internal"
    },
    {
      "id": "insert",
      "title": "Use room",
      "slot": "internal"
    },
    {
      "id": "acknowledge",
      "title": "Finish room workflow",
      "slot": "internal"
    },
    {
      "id": "create-meeting-room",
      "title": "Создать комнату",
      "slot": "meeting.create"
    }
  ],
  "views": [
    {
      "id": "panel",
      "title": "Контур.Толк · KTalk",
      "file": "panel.html",
      "slot": "panel",
      "height": 500
    }
  ],
  "files": [
    "main.js",
    "core.js",
    "config.js",
    "i18n.js",
    "panel.html",
    "panel.js",
    "panel.css",
    "LICENSE"
  ],
  "optionalOrigins": [
    {
      "domain": "ktalk.ru",
      "includeSubdomains": true
    }
  ],
  "settingsVersion": 1
}
